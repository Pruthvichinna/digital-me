# Free Postgres from neon.tech (direct connection, pooling OFF). Paste the whole string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Free LLM from console.groq.com (no credit card). Paste your key after the = sign.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Companion mode is private. Requests need this key in the X-API-Key header.
# Make up a long random string (README shows how).
COMPANION_API_KEY=

PUBLIC_RATE_LIMIT_PER_MIN=20
